{
  "name": "@zarya/events",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "exports": {
    "./public/*": "./public/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./admin": {
      "types": "./admin/index.d.ts",
      "svelte": "./admin/src/EventsAdmin.svelte",
      "default": "./admin/src/EventsAdmin.svelte"
    }
  },
  "files": [
    "docs",
    "dist",
    "admin",
    "public",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig admin/tsconfig.json",
    "format": "eslint . --fix",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1"
  },
  "peerDependencies": {
    "@zarya/addon-contracts": "0.3.0",
    "mongoose": "9.11.2",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.0.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@zarya/addon-contracts": "file:vendor/zarya-addon-contracts-0.3.0.tgz",
    "eslint": "9.39.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "16.5.0",
    "mongoose": "9.11.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
